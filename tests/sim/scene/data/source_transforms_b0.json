  "nonpublic_helper_boundary": {
    "case": [
      {
        "id": "unsupported-scale-policy",
        "config": {
          "body_scale": [
            1,
            2,
            3
          ]
        },
        "steps": [
          [
            "scale",
            {
              "policy": "unsupported",
              "requested": [
