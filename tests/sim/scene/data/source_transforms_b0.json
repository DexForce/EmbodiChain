                1,
                1
              ]
            }
          ]
        ],
        "expected": {
          "serialized": "{\"body_scale\":[1.0,1.0,1.0]}"
        }
      }
    ],
    "qualification": "The old public prepare_scene rejects unsupported policy before invoking the helper; private helper fallthrough is not an accepted public mode. The new owner preserves that existing public rejection."
  }
