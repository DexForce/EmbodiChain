<?xml version="1.0"?>
<robot name="free_motion_fixture">
  <link name="base"><collision><origin xyz="0 0 0.3"/><geometry><box size="0.1 0.1 0.1"/></geometry></collision></link>
  <link name="mount"/>
  <joint name="mount_fixed" type="fixed"><parent link="base"/><child link="mount"/><origin xyz="0 0 0.3"/></joint>
  <link name="shoulder"><collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision></link>
  <joint name="arm_slide" type="prismatic"><parent link="mount"/><child link="shoulder"/><axis xyz="1 0 0"/><limit lower="-1" upper="1" effort="100" velocity="20"/></joint>
  <link name="middle"><collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision></link>
  <joint name="arm_fold" type="prismatic"><parent link="shoulder"/><child link="middle"/><origin xyz="0.3 0 0"/><axis xyz="1 0 0"/><limit lower="-1" upper="1" effort="100" velocity="20"/></joint>
  <link name="wrist"/>
  <joint name="wrist_fixed" type="fixed"><parent link="middle"/><child link="wrist"/><origin xyz="0.1 0 0"/></joint>
  <link name="tool"><collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision></link>
  <joint name="tool_fixed" type="fixed"><parent link="wrist"/><child link="tool"/><origin xyz="0.15 0 0"/></joint>
  <link name="pad_a"><collision><geometry><box size="0.1 0.06 0.06"/></geometry></collision></link>
  <joint name="jaw_a" type="prismatic"><parent link="tool"/><child link="pad_a"/><origin xyz="0.04 0.02 0"/><axis xyz="0 1 0"/><limit lower="-1" upper="1" effort="100" velocity="20"/></joint>
  <link name="pad_b"><collision><geometry><box size="0.1 0.06 0.06"/></geometry></collision></link>
  <joint name="jaw_b" type="prismatic"><parent link="tool"/><child link="pad_b"/><origin xyz="0.04 -0.02 0"/><axis xyz="0 -1 0"/><limit lower="-1" upper="1" effort="100" velocity="20"/></joint>
  <link name="passive"><collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision></link>
  <joint name="passive_slide" type="prismatic"><parent link="base"/><child link="passive"/><origin xyz="1.2 0 0.3"/><axis xyz="0 1 0"/><limit lower="-1" upper="1" effort="100" velocity="20"/></joint>
</robot>
