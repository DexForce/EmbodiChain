    <origin xyz="0.08657 -0.0249 -0.00024366" rpy="0 0 0" />
    <parent link="link6" />
    <child link="link8" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.044" effort="100" velocity="1000" />
  </joint>
  <link name="ee_link" />
  <joint name="joint_ee" type="fixed">
    <origin xyz="0.06 0.0 0.0" rpy="0 1.570796 0" />
    <parent link="link6" />
    <child link="ee_link" />
  </joint>
</robot>
