from __future__ import annotations
import os
os.environ.update(CUDA_VISIBLE_DEVICES='', OMP_NUM_THREADS='1', MKL_NUM_THREADS='1', OPENBLAS_NUM_THREADS='1', HF_HUB_OFFLINE='1', HF_DATASETS_OFFLINE='1')
os.sched_setaffinity(0, set(range(16,24)))
import hashlib, json, platform, tempfile, time
from importlib.metadata import version
from pathlib import Path
import torch
from lerobot.datasets.lerobot_dataset import LeRobotDataset
from examples.ods.data_stream_demo.lerobot_io import StandardLeRobotWriter, read_lerobot_manifest, audit_video_quality
from examples.ods.data_stream_demo.payload import numeric_episode_digest
BASE=Path('/tmp/ods-recorder-profile-20261023')

def main():
    torch.set_num_threads(1)
    output=Path(tempfile.mkdtemp(prefix='real-profile-',dir=BASE))
    results={'scope':'one real 479-frame PickPlace episode per vision, decoded from retained formal standard dataset outside writer timing; recording-only cold run, no throughput/speedup claim and no GPU; first-source raw references are the decoded input, so video audit measures an additional AV1 generation','cpus':sorted(os.sched_getaffinity(0)),'torch_threads':torch.get_num_threads(),'encoder_threads':1,'parallel_encoding':False,'versions':{name:version(name) for name in ('torch','torchcodec','lerobot')},'platform':platform.platform(),'runs':{}}
    for vision in ('single','dual'):
        source=Path('/tmp/ods-visual-training-formal-20261021-v3/offline32')/vision/'seed19001/lerobot_dataset'
        manifest=read_lerobot_manifest(source)
        record=manifest['episodes'][0]
        length=record['length']
        dataset=LeRobotDataset('local/ods-data-stream',root=source,video_backend='torchcodec',tolerance_s=1e-4)
        start=time.monotonic()
        state,actions,provenance=[],[],[]
        images={name:torch.empty(length,256,256,3,dtype=torch.uint8) for name in manifest['payload']['cameras']}
        for i in range(length):
            row=dataset[i]
            state.append(row['observation.state']);actions.append(row['action']);provenance.append(row['ods.provenance'])
            for name in images:
                images[name][i].copy_(row[f'observation.images.{name}'].movedim(0,-1).mul(255).round().to(torch.uint8))
        prov=torch.stack(provenance)
        episode={'state':torch.stack(state),'actions':torch.stack(actions),'valid':torch.ones(length,dtype=torch.bool),'frame_ids':prov[:,:3],'generations':prov[:,3],'continuity_id':prov[:,4],'published_at_monotonic_ns':prov[:,5],'images':images}
        assert numeric_episode_digest(episode)==record['numeric_sha256']
        decoded_seconds=time.monotonic()-start
        del dataset,state,actions,provenance
        root=output/vision/'corpus';events=output/vision/'writer-events.jsonl'
        writer=StandardLeRobotWriter(root,manifest['payload'],episode_count=1,events_path=events,encoder_threads=1,operation_timeout=180)
        writer.submit(episode)
        stats=writer.finalize()
        assert stats['written_episodes']==1 and stats['valid_frames']==length and stats['worker_joined']
        reread=read_lerobot_manifest(root)
        assert reread['episodes'][0]['numeric_sha256']==record['numeric_sha256']
        quality=audit_video_quality(root)
        assert quality['worker_cleanup']['workers_joined'] and not quality['worker_cleanup']['forced_termination']
        results['runs'][vision]={'input_dataset':str(source),'input_manifest_sha256':hashlib.sha256((source/'meta/ods_data_stream.json').read_bytes()).hexdigest(),'input_record':record,'decode_input_seconds_excluded':decoded_seconds,'writer_stats':stats,'events':[json.loads(s) for s in events.read_text().splitlines()],'quality_against_decoded_inputs':quality}
        print(vision,json.dumps(stats),flush=True)
        del episode,images
    results['source_sha256']=hashlib.sha256(Path('examples/ods/data_stream_demo/lerobot_io.py').read_bytes()).hexdigest()
    (output/'profile.json').write_text(json.dumps(results,indent=2)+'\n')
    print(str(output/'profile.json'),flush=True)
if __name__=='__main__':main()
