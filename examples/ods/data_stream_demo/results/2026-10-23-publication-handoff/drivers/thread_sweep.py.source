from __future__ import annotations
import os
os.environ.update(CUDA_VISIBLE_DEVICES='', OMP_NUM_THREADS='1', MKL_NUM_THREADS='1', OPENBLAS_NUM_THREADS='1', HF_HUB_OFFLINE='1', HF_DATASETS_OFFLINE='1')
os.sched_setaffinity(0,set(range(16,24)))
import hashlib,json,math,platform,statistics,tempfile,time
from importlib.metadata import version
from pathlib import Path
import torch
from lerobot.datasets.lerobot_dataset import LeRobotDataset
from examples.ods.data_stream_demo.lerobot_io import StandardLeRobotWriter,read_lerobot_manifest
from examples.ods.data_stream_demo.payload import numeric_episode_digest
BASE=Path('/tmp/ods-recorder-profile-20261023')

def load_input(vision):
    root=Path('/tmp/ods-visual-training-formal-20261021-v3/offline32')/vision/'seed19001/lerobot_dataset'
    manifest=read_lerobot_manifest(root);record=manifest['episodes'][0];length=record['length']
    dataset=LeRobotDataset('local/ods-data-stream',root=root,video_backend='torchcodec',tolerance_s=1e-4)
    state,actions,provenance=[],[],[]
    images={name:torch.empty(length,256,256,3,dtype=torch.uint8) for name in manifest['payload']['cameras']}
    for i in range(length):
        row=dataset[i]
        state.append(row['observation.state']);actions.append(row['action']);provenance.append(row['ods.provenance'])
        for name in images:
            images[name][i].copy_(row[f'observation.images.{name}'].movedim(0,-1).mul(255).round().to(torch.uint8))
    prov=torch.stack(provenance)
    episode={'state':torch.stack(state),'actions':torch.stack(actions),'valid':torch.ones(length,dtype=torch.bool),'frame_ids':prov[:,:3],'generations':prov[:,3],'continuity_id':prov[:,4],'published_at_monotonic_ns':prov[:,5],'images':images}
    assert numeric_episode_digest(episode)==record['numeric_sha256']
    return manifest,episode,{'dataset':str(root),'manifest_sha256':hashlib.sha256((root/'meta/ods_data_stream.json').read_bytes()).hexdigest(),'record':record,'image_sha256':{k:hashlib.sha256(v.numpy().tobytes()).hexdigest() for k,v in images.items()}}

def audit(root,episode):
    dataset=LeRobotDataset('local/ods-data-stream',root=root,video_backend='torchcodec',tolerance_s=1e-4)
    assert len(dataset)==len(episode['valid'])
    errors={name:{'abs':0.,'square':0.,'values':0,'frames':0,'decoded_sha256':hashlib.sha256()} for name in episode['images']}
    for i in range(len(dataset)):
        row=dataset[i]
        torch.testing.assert_close(row['observation.state'],episode['state'][i],rtol=0,atol=0)
        torch.testing.assert_close(row['action'],episode['actions'][i],rtol=0,atol=0)
        for name,raw in episode['images'].items():
            decoded=row[f'observation.images.{name}'].movedim(0,-1).double().mul(255)
            diff=decoded-raw[i].double();stat=errors[name]
            stat['abs']+=float(diff.abs().sum());stat['square']+=float(diff.square().sum());stat['values']+=diff.numel();stat['frames']+=1
            stat['decoded_sha256'].update(decoded.round().to(torch.uint8).numpy().tobytes())
    quality={}
    for name,stat in errors.items():
        mse=stat['square']/stat['values']
        quality[name]={'frames':stat['frames'],'mae_uint8':stat['abs']/stat['values'],'psnr_db':10*math.log10(255**2/mse) if mse else None,'decoded_uint8_sha256':stat['decoded_sha256'].hexdigest()}
        assert quality[name]['frames']==479 and quality[name]['mae_uint8']<5
    return quality

def main():
    torch.set_num_threads(1)
    output=Path(tempfile.mkdtemp(prefix='thread-sweep-',dir=BASE));started=time.monotonic()
    loaded={vision:load_input(vision) for vision in ('single','dual')}
    inputs_ready=time.monotonic()
    result={'scope':'real 479-frame fixed input per vision, 256x256 RGB; 2 repeats per 1/2/4 encoder threads, reverse order in second round; SDK recording timings exclude initial decode and full-frame verification; CPU-only, no learner/simulation overlap, no application speedup conclusion','cpus':sorted(os.sched_getaffinity(0)),'torch_threads':1,'parallel_encoding':False,'input_load_seconds':inputs_ready-started,'versions':{k:version(k) for k in ('torch','lerobot','torchcodec')},'platform':platform.platform(),'inputs':{v:d[2] for v,d in loaded.items()},'temporary_peak_disk_bytes':None,'temporary_peak_disk_scope':'not sampled to avoid filesystem profiling in timing region; final corpus bytes measured after audit','runs':[]}
    for repeat,order in enumerate(((1,2,4),(4,2,1))):
        visions=('single','dual') if repeat==0 else ('dual','single')
        for threads in order:
            for vision in visions:
                manifest,episode,_=loaded[vision];root=output/f'repeat{repeat}-{vision}-threads{threads}'/'corpus';events=root.parent/'writer-events.jsonl'
                start=time.monotonic()
                writer=StandardLeRobotWriter(root,manifest['payload'],episode_count=1,events_path=events,encoder_threads=threads,operation_timeout=180)
                writer.submit(episode);stats=writer.finalize();elapsed=time.monotonic()-start
                assert stats['worker_joined'] and stats['finalized'] and stats['valid_frames']==479
                m=read_lerobot_manifest(root)
                assert m['video']=={'codec':'libsvtav1','pix_fmt':'yuv420p','gop':2,'crf':30,'encoder_threads':threads,'parallel_encoding':False}
                assert m['episodes'][0]['numeric_sha256']==numeric_episode_digest(episode)==manifest['episodes'][0]['numeric_sha256']
                quality=audit(root,episode)
                row={'repeat':repeat,'vision':vision,'encoder_threads':threads,'writer_start_to_join_seconds':elapsed,'stats':stats,'quality':quality,'final_corpus_bytes':sum(p.stat().st_size for p in root.rglob('*') if p.is_file()),'events':[json.loads(s) for s in events.read_text().splitlines()]}
                result['runs'].append(row)
                (output/'progress.json').write_text(json.dumps(result,indent=2)+'\n')
                print(json.dumps({'repeat':repeat,'vision':vision,'threads':threads,'writer_seconds':elapsed,'stages':stats['sdk_episode_stage_seconds']}),flush=True)
    aggregate=[]
    for vision in ('single','dual'):
        for threads in (1,2,4):
            rows=[r for r in result['runs'] if r['vision']==vision and r['encoder_threads']==threads]
            metrics={'writer_start_to_join_seconds':[r['writer_start_to_join_seconds'] for r in rows],'sdk_write_encode_seconds':[r['stats']['sdk_write_encode_seconds'] for r in rows]}
            for name in ('sdk_create_seconds','sdk_finalize_seconds'):
                metrics[name]=[r['stats'][name] for r in rows]
            for name in rows[0]['stats']['sdk_episode_stage_seconds']:
                metrics[name]=[r['stats']['sdk_episode_stage_seconds'][name] for r in rows]
            aggregate.append({'vision':vision,'encoder_threads':threads,'repeats':2,'metrics':{name:{'mean':statistics.mean(v),'min':min(v),'max':max(v),'samples':v} for name,v in metrics.items()}})
    result['aggregate']=aggregate
    result['all_decoded_camera_frames']=sum(q['frames'] for r in result['runs'] for q in r['quality'].values())
    result['elapsed_seconds']=time.monotonic()-started
    result['source_sha256']=hashlib.sha256(Path('examples/ods/data_stream_demo/lerobot_io.py').read_bytes()).hexdigest()
    result['passed']=True
    (output/'profile.json').write_text(json.dumps(result,indent=2)+'\n')
    print(str(output/'profile.json'),flush=True)
if __name__=='__main__':main()
