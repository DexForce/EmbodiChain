"""Independent, post-termination publication pilot audit; CPU only."""
from __future__ import annotations

import argparse
from collections import Counter, defaultdict
import hashlib
import importlib.util
import json
import math
from pathlib import Path
import statistics
import subprocess
from typing import Any

REPO = Path('/root/sources/EmbodiChain-ods-stream-design')
REFERENCE = REPO / 'examples/ods/data_stream_demo/results/2026-10-21-visual-training/independent_audit.py'
spec = importlib.util.spec_from_file_location('original_independent_audit', REFERENCE)
old = importlib.util.module_from_spec(spec)
spec.loader.exec_module(old)
STAGES = ('validation_provenance', 'add_frame', 'save_episode', 'references_manifest')


def jsonl(path):
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


def source_receipt(manifest, revision):
    errors=[]
    if not isinstance(manifest,dict) or not manifest:
        return {'passed':False,'errors':['missing actual source manifest'],'files':0}
    for name,expected in manifest.items():
        try:
            blob=subprocess.check_output(['git','show',f'{revision}:{name}'],cwd=REPO,stderr=subprocess.PIPE)
            actual=hashlib.sha256(blob).hexdigest()
            if actual!=expected:errors.append(f'{name}: frozen git blob SHA differs')
        except subprocess.CalledProcessError as exc:errors.append(f'{name}: not in frozen commit')
    return {'passed':not errors,'files':len(manifest),'errors':errors,'source_sha256':manifest}


def process_receipt(path):
    p=old.read(path)
    okay=(p.get('status')=='complete' and p.get('returncode')==0
          and not any(p.get(k) for k in ('timeout','cancelled','leaked_process_group'))
          and p.get('process_group_shutdown',{}).get('group_disappeared') is True
          and not p.get('device_guard',{}).get('unexpected_contexts'))
    return {'passed':okay,'returncode':p.get('returncode'),'elapsed_seconds':p.get('elapsed_seconds'),
            'group_disappeared':p.get('process_group_shutdown',{}).get('group_disappeared'),
            'unexpected_contexts':p.get('device_guard',{}).get('unexpected_contexts',[])}


def stage_receipt(directory, metrics):
    errors=[];totals=Counter();previous=0;ordinals=[]
    events=jsonl(directory/'writer-sdk-events.jsonl')
    for row in events:
        if not (row.get('status')=='complete' and previous<=row['start_ns']<=row['end_ns']):
            errors.append('writer service status/order')
        previous=row['end_ns']
        if row['name']!='sdk_episode_write_encode':continue
        ordinals.append(row['episode_ordinal'])
        stages=row.get('stage_intervals',{})
        if set(stages)!=set(STAGES):errors.append('writer does not retain exactly four substages');continue
        cursor=row['start_ns'];duration=0
        for name in STAGES:
            s=stages[name]
            if not (s.get('status')=='complete' and cursor<=s['start_ns']<=s['end_ns']<=row['end_ns']
                    and s['duration_ns']==s['end_ns']-s['start_ns']):errors.append(f'invalid/disordered/overlapping {name}')
            cursor=s['end_ns'];duration+=s['duration_ns'];totals[name]+=s['duration_ns']/1e9
        if duration>row['end_ns']-row['start_ns']:errors.append('substages exceed parent span')
    if ordinals!=list(range(metrics['published_sources'])):errors.append('writer episode FIFO/source count')
    for name,value in totals.items():
        if not math.isclose(value,metrics['writer']['sdk_episode_stage_seconds'][name],rel_tol=1e-9,abs_tol=1e-7):
            errors.append(f'{name} aggregate disagreement')
    if old.digest(directory/'writer-sdk-events.jsonl')!=metrics['writer_sdk_events_sha256']:errors.append('writer log SHA differs')
    outer=sum((r['end_ns']-r['start_ns'])/1e9 for r in events if r['name']=='sdk_episode_write_encode')
    return {'passed':not errors,'errors':errors,'episode_stage_seconds':dict(totals),'episode_outer_seconds':outer,
            'uninstrumented_episode_seconds':outer-sum(totals.values()),
            'scope':'Four disjoint substages nested inside writer service; never added to overlapping generation/training wall time'}


def validate_blocks(trace, config):
    errors=[];blocks=trace.get('retained_blocks',[]);previous=0;next_ordinal=0
    if trace.get('format')!='ods-visual-training-trace-v2':errors.append('missing v2 trace')
    for key in ('handoff_mode','encoder_threads','updates','batch_size','buffer_size','producer_envs','episode_budget','prediction_horizon'):
        if trace['recipe'].get(key)!=config[key]:errors.append(f'trace recipe {key}')
    for i,b in enumerate(blocks):
        n=len(b['ordinals']);expected=config['buffer_size'] if i==0 or config['handoff_mode']=='generation' else config['producer_envs']
        if not (n==expected and b['ordinals']==list(range(next_ordinal,next_ordinal+n)) and
                previous<b['first_update']<=config['updates'] and n*config['episode_budget']>=config['batch_size']):
            errors.append(f'retained block {i}')
        previous=b['first_update'];next_ordinal+=n
        stop=blocks[i+1]['first_update'] if i+1<len(blocks) else config['updates']+1
        rows=trace['updates'][b['first_update']-1:stop-1]
        if not rows or Counter(x[0] for x in rows[0]['pairs'])!=Counter({o:config['batch_size']//n for o in b['ordinals']}):
            errors.append(f'block {i} first-batch source coverage')
        if any(u['generation']!=b['generation'] or any(o not in b['ordinals'] for o,_ in u['pairs']) for u in rows):
            errors.append(f'block {i} update escaped retained sources')
    if not blocks or blocks[0]['first_update']!=1:errors.append('initial retained block missing')
    return {'passed':not errors,'errors':errors,'block_count':len(blocks),'block_sizes':[len(b['ordinals']) for b in blocks]}


def audit_run(directory, label, revision):
    summary=old.read(directory/'summary.json');config=summary['config'];m=summary.get('training_metrics',{});errors=[]
    result={'directory':str(directory),'label':label,'vision':config['vision'],'seed':config['seed'],'errors':errors}
    # This check happens before opening any checkpoint or hashing corpus bytes.
    if summary.get('status')!='complete' or summary.get('post_audit_status')!='complete':
        raise RuntimeError(f'Run is not terminal and audited: {directory}')
    required=dict(updates=128,batch_size=32,prediction_horizon=32,history_length=2,buffer_size=8,producer_envs=4,episode_budget=128,encoder_threads=2,seed=19001)
    if any(config.get(k)!=v for k,v in required.items()):errors.append('declared fixed pilot work/resources differ')
    expected_handoff='generation' if label=='generation_control' else 'publication'
    if config.get('handoff_mode')!=expected_handoff:errors.append('handoff mode differs from labeled comparison')
    if not summary.get('qualification_passed'):errors.append('reported qualification failed')
    env=old.read(directory/'environment.json');result['source']=source_receipt(env.get('source_sha256'),revision)
    if not result['source']['passed']:errors.append('run source manifest differs')
    if env.get('commit')!=revision:errors.append('run commit differs from frozen implementation')
    result['hardware']={k:env.get(k) for k in ('cuda_visible_devices','cpu_affinity','torch_threads','auxiliary_graphics_gpu_uuid')}
    result['process']={name:process_receipt(directory/file) for name,file in [('training','process.json'),('audit','audit-process.json')]}
    if not all(r['passed'] for r in result['process'].values()):errors.append('process exit/device/group audit failed')
    if not old.equivalent(result['process']['training']['elapsed_seconds'],m['total_seconds']):errors.append('supervisor total mismatch')
    result['reconstruction']=old.reconstruct_metrics(directory)
    if not result['reconstruction']['passed']:errors.append('independent coverage/count reconstruction failed')
    for name,value in [('completed_updates',128),('trained_chunks',4096),('valid_target_occurrences',131072)]:
        if m.get(name)!=value:errors.append(f'fixed completed work {name}')
    ck={name:old.checkpoint_model_hash(directory/f'{name}.pt') for name in ('initial','final')}
    result['checkpoints']=ck
    if not (ck['initial']['model_sha256']==m['initial_model_sha256'] and ck['final']['model_sha256']==m['final_model_sha256'] and
            ck['final']['normalization_sha256']==m['normalization_sha256'] and ck['final']['step']==128 and
            ck['final']['optimizer_steps']==[128] and ck['initial']['model_sha256']!=ck['final']['model_sha256']):errors.append('checkpoint/update/hash mismatch')
    result['full_video']=old.full_video_evidence(directory,summary)
    if not result['full_video']['passed']:errors.append('retained full-video evidence failed')
    a=summary.get('post_audit',{});decode=a.get('decode',{});closed=a.get('decode_shutdown',{})
    if not (a.get('passed') and a.get('recording',{}).get('all_numeric_sha256_verified') and
            a.get('training',{}).get('checkpoint_verified') and decode.get('episodes')==m['published_sources'] and
            decode.get('stats',{}).get('video_backend')=='torchcodec CPU' and
            closed.get('workers_joined') and not closed.get('forced_termination') and not closed.get('cleanup_errors') and
            all(code==0 for code in closed.get('worker_exitcodes',[]))):errors.append('numeric/SDK decode/decoder cleanup contract')
    if summary.get('cleanup',{}).get('producer')!={'joined':True,'exitcode':0}:errors.append('producer cleanup')
    if not (m['writer']['finalized'] and m['writer']['worker_joined'] and m['writer']['peak_queued_episodes']<=2 and
            m['writer']['submitted_episodes']==m['writer']['written_episodes']==m['published_sources'] and
            m['peak_owned_raw_episodes']<=config['buffer_size'] and m['owned_raw_episode_limit']==config['buffer_size']):errors.append('bounded/raw/writer/count contract')
    result['recording_stages']=stage_receipt(directory,m)
    if not result['recording_stages']['passed']:errors.append('recording substage contract')
    events=jsonl(directory/'training-events.jsonl');pubs={e['source_id']:e for e in events if e['kind']=='episode_published'}
    ends={g:max(e['monotonic_ns'] for e in pubs.values() if e['generation']==g) for g in {e['generation'] for e in pubs.values()}}
    updates=[e for e in events if e['kind']=='update_completed'];early=[];first={}
    for u in updates:
        generations={c['generation'] for c in u['chunks']}
        if any(g>1 and u['monotonic_ns']<ends[g] for g in generations):early.append(u['update'])
        for c in u['chunks']:first.setdefault(c['source_id'],u['monotonic_ns'])
    if len(early)!=m['updates_before_generation_fully_published']:errors.append('independent early update count differs')
    if config['arm']=='ods_serial' and early:errors.append('serial trained before entire generation publication')
    def latency_stats(selected):
        delays=sorted((stamp-pubs[sid]['monotonic_ns'])/1e9 for sid,stamp in first.items() if selected(pubs[sid]))
        if not delays:return None
        def quantile(q):
            x=(len(delays)-1)*q;i=int(x);return delays[i]+(delays[min(i+1,len(delays)-1)]-delays[i])*(x-i)
        return {'p50':quantile(.5),'p95':quantile(.95)}
    latency=latency_stats(lambda pub:True)
    post_initial_latency=latency_stats(lambda pub:pub['generation']>1)
    post_initial_trained=sum(pubs[sid]['generation']>1 for sid in first)
    post_initial_published=sum(pub['generation']>1 for pub in pubs.values())
    if any(not old.equivalent(latency[k],m['publication_to_first_training_seconds'][k]) for k in latency):errors.append('independent publication latency differs')
    result['early_training']={'count':len(early),'update_ids':early,'generation_last_publication_ns':ends}
    result['trace']=None
    if config['arm']!='offline':
        trace=old.read(directory/'training-trace.json');result['trace']=validate_blocks(trace,config)
        if not result['trace']['passed']:errors.append('retained-block trace contract')
    interval_totals=Counter()
    for row in m['intervals']:interval_totals[row['name']]+=row['duration_seconds']
    result['metrics']={k:m[k] for k in ('total_seconds','first_update_seconds','training_complete_seconds','post_training_drain_seconds','trained_sources','effective_sources','published_sources','untrained_sources','initial_xy_occupied_cells','anchor_xyz_occupied_voxels','unique_target_frames','unique_anchors','target_duplicate_fraction','max_source_trained_chunks','peak_owned_raw_episodes','dataset_bytes')}
    result['metrics'].update(publication_to_first_training_seconds=latency,post_initial_publication_to_first_training_seconds=post_initial_latency,post_initial_trained_sources=post_initial_trained,post_initial_published_sources=post_initial_published,post_initial_untrained_sources=post_initial_published-post_initial_trained,early_updates=len(early),interval_seconds=dict(interval_totals))
    result['evaluation']={'requested':summary.get('requested_evaluation_scenes'),'status':summary.get('evaluation_status'),'policy_quality_claim':False}
    if result['evaluation']['requested']!=0 or result['evaluation']['status']!='not_requested':errors.append('pilot evaluation scope differs')
    result['qualified']=not errors
    return result


def pair_receipt(left,right):
    errors=[];a=old.read(Path(left['directory'])/'training-trace.json');b=old.read(Path(right['directory'])/'training-trace.json')
    numeric=lambda trace:[(x['ordinal'],x['generation'],x['length'],x['numeric_sha256']) for x in trace['episodes']]
    checks={key:a[key]==b[key] for key in ('recipe','updates','retained_blocks','initial_model_sha256','normalization_sha256')}
    checks['numeric_manifest']=numeric(a)==numeric(b)
    checks['hardware']=left['hardware']==right['hardware']
    for key,okay in checks.items():
        if not okay:errors.append(key)
    # Encoded/video-byte identity is not a raw RGB guarantee.
    return {'vision':left['vision'],'passed':not errors,'checks':checks,'errors':errors,
            'overlap_seconds':left['metrics']['total_seconds'],'serial_seconds':right['metrics']['total_seconds'],
            'overlap_time_saving_fraction':1-left['metrics']['total_seconds']/right['metrics']['total_seconds'],
            'final_model_sha256_equal':left['checkpoints']['final']['model_sha256']==right['checkpoints']['final']['model_sha256'],
            'scope':'Matching numeric corpus, ordered training work and retained blocks. Raw RGB identity is not established; no policy evaluation was run.'}


def report(result):
    lines=['# Publication handoff pilot: independent audit','',
           f"Frozen implementation: `{result['implementation']}`. Qualified runs: {sum(r['qualified'] for r in result['runs'])}/{len(result['runs'])}.",
           '', 'One seed; fixed 128 updates, 4,096 chunks and 131,072 valid action targets per run. Evaluation is disabled; no policy-quality or learning-efficiency conclusion.',
           '', '| Mode | Vision | Total s | First update s | Trained / saved | Early updates | All-source publish→train p50 / p95 s | Post-initial p50 / p95 s | Staging wait s |',
           '|---|---|---:|---:|---:|---:|---:|---:|---:|']
    for r in sorted(result['runs'],key=lambda x:(x['vision'],x['label'])):
        m=r['metrics'];d=m['publication_to_first_training_seconds'];post=m['post_initial_publication_to_first_training_seconds'];wait=m['interval_seconds'].get('recording_staging_wait',0)
        post_text=f"{post['p50']:.3f} / {post['p95']:.3f}" if post else 'n/a'
        lines.append(f"| {r['label']} | {r['vision']} | {m['total_seconds']:.2f} | {m['first_update_seconds']:.2f} | {m['trained_sources']} / {m['published_sources']} | {m['early_updates']} | {d['p50']:.3f} / {d['p95']:.3f} | {post_text} | {wait:.2f} |")
    lines+=['','## Interpretation boundaries','',
            '- Publication latency and early-update counts are independently reconstructed from completed optimizer events and the last publication timestamp in each generation.',
            '- All-source latency includes initial fill and shared normalization. Post-initial latency includes only sources from generation > 1 that actually completed training. Untrained published sources remain separately counted and do not receive invented zero latency.',
            '- The four recorder substages partition SDK episode service. Their sums must not be added to overlapping generation/training wall time.',
            '- Serial preserves recording/generation overlap and reproduces numeric sources and ordered update work. Raw RGB equality is not established, even if encoded or decoded YUV hashes happen to agree.',
            '- One seed and shared-host measurements do not establish a stable speedup. State coverage and accepted source counts remain separate metrics.',
            '- Earlier smoke-v1 used the older serial barrier and is engineering qualification only; it is excluded here.']
    for p in result['serial_pairs']:
        lines.append(f"- {p['vision']} paired serial contract: {'PASS' if p['passed'] else 'FAIL'}; overlap time saving {100*p['overlap_time_saving_fraction']:.2f}% (negative means slower).")
    if result['errors']:lines+=['','Audit errors:',*[f'- {e}' for e in result['errors']]]
    return '\n'.join(lines)+'\n'


def main():
    parser=argparse.ArgumentParser();parser.add_argument('--root',type=Path,default=Path('/tmp/ods-publication-20261023'));parser.add_argument('--output',type=Path,required=True)
    parser.add_argument('--implementation',default='8f101b297');args=parser.parse_args()
    revision=subprocess.check_output(['git','rev-parse',args.implementation],cwd=REPO,text=True).strip()
    pilot=args.root/'pilot';suite=old.read(pilot/'suite-summary.json')
    if suite.get('status')!='complete':raise RuntimeError('Pilot suite is not terminal complete; refusing checkpoint scan')
    source=source_receipt(suite.get('source_sha256'),revision)
    directories=[]
    for path in sorted(pilot.rglob('summary.json')):
        rel=path.parent.relative_to(pilot)
        if rel.parts[0]=='main':label=rel.parts[1]
        elif rel.parts[:2]==('controls','eager'):label='eager'
        else:continue
        directories.append((path.parent,label))
    for path in sorted((args.root/'generation-controls').rglob('summary.json')):directories.append((path.parent,'generation_control'))
    counts=Counter(label for _,label in directories)
    if counts!={'offline32':2,'ods_overlap':2,'ods_serial':2,'eager':2,'generation_control':2}:
        raise RuntimeError(f'Expected terminal 8 pilot + 2 generation runs, found {dict(counts)}')
    runs=[]
    for directory,label in directories:
        print(f'Auditing {label}/{directory}',flush=True)
        runs.append(audit_run(directory,label,revision))
    errors=[]
    if not source['passed']:errors.append('suite source manifest mismatch')
    for r in runs:
        errors.extend(f"{r['label']}/{r['vision']}: {x}" for x in r['errors'])
        common=set(source['source_sha256']) & set(r['source']['source_sha256'])
        if any(source['source_sha256'][name]!=r['source']['source_sha256'][name] for name in common):errors.append(f"{r['directory']}: suite/run source mismatch")
    pairs=[];contrasts=[]
    for vision in ('single','dual'):
        by_label={r['label']:r for r in runs if r['vision']==vision}
        pair=pair_receipt(by_label['ods_overlap'],by_label['ods_serial']);pairs.append(pair)
        if not pair['passed']:errors.append(f'{vision}: serial pair contract')
        baseline=by_label['ods_overlap']
        for label in ('offline32','eager','generation_control'):
            control=by_label[label]
            matched=baseline['hardware']==control['hardware']
            if not matched:errors.append(f'{vision}: {label} hardware mismatch')
            contrasts.append({'vision':vision,'baseline':'ods_overlap','control':label,'hardware_matched':matched,
                              'ods_time_saving_fraction':1-baseline['metrics']['total_seconds']/control['metrics']['total_seconds'],
                              'scope':'Descriptive one-seed systems comparison; corpus/order may differ except audited serial trace'})
    result={'schema':'ods-publication-independent-audit/v1','implementation':revision,'passed':not errors,'errors':errors,
            'suite_source':source,'runs':runs,'serial_pairs':pairs,'contrasts':contrasts,
            'limits':['one seed','no evaluation','raw RGB identity unproven','smoke-v1 excluded from attribution']}
    args.output.mkdir(parents=True,exist_ok=True);old.write(args.output/'independent-audit.json',result)
    (args.output/'INDEPENDENT-AUDIT.md').write_text(report(result))
    print(json.dumps({'passed':result['passed'],'runs':len(runs),'errors':errors},indent=2))
    if errors:raise SystemExit(1)

if __name__=='__main__':main()
