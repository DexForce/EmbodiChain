from __future__ import annotations

import copy
import gc
import json
import multiprocessing as mp
import tempfile
import time
import types
import weakref
from pathlib import Path

import torch
from tensordict import TensorDict

from embodichain.data_pipeline.engine.data import _populate_provenance
from examples.ods.data_stream_demo import train
from examples.ods.data_stream_demo.payload import describe_raw_buffer

C, P, B, K, T = 4, 2, 4, 4, 8
RUN = 91


def buffer():
    cube = torch.zeros(C,T,7);cube[...,6]=1
    obs=TensorDict({
        'robot':TensorDict({'qpos':torch.zeros(C,T,9),'qvel':torch.zeros(C,T,9)},[C,T]),
        'tcp_pose':torch.eye(4).expand(C,T,4,4).clone(),
        'cube_pose':cube,'goal_position':torch.zeros(C,T,3),
        'cube_velocity':torch.zeros(C,T,6),
        'sensor':TensorDict({'cam_high':TensorDict({'color':torch.zeros(C,T,4,4,4,dtype=torch.uint8)},[C,T])},[C,T]),
    },[C,T])
    row=TensorDict({'obs':obs,'actions':torch.zeros(C,T,7),
                    'valid':torch.ones(C,T,dtype=torch.bool),
                    'continuity_id':torch.zeros(C,T,dtype=torch.int64)},[C,T])
    for key in ('ods_run_id','ods_episode_id','ods_generation','ods_frame_index',
                'ods_accepted_at_ns','ods_published_at_monotonic_ns'):
        row[key]=torch.full((C,T),-1,dtype=torch.int64)
    return row


class Engine:
    buffer_size=C
    run_id=RUN
    def __init__(self, fail_at=None, never_publish=False):
        self.shared_buffer=buffer()
        self._lock_index=mp.get_context('spawn').Array('i',[-1,-1])
        self.requested=self.completed=1;self.accepted=C
        self.slot=0;self.ticks=0;self.period=4;self.fail_at=fail_at;self.never_publish=never_publish
        self.stamp(0,C,1)
    def stamp(self,start,stop,g):
        rows=self.shared_buffer[start:stop]
        rows['obs','robot','qpos'].fill_(float(g))
        rows['obs','sensor','cam_high','color'].fill_(g)
        _populate_provenance(rows,run_id=RUN,generation=g,episode_start=(g-1)*C+start,accepted_at_ns=123)
    def tick(self):
        self.ticks+=1
        self.check_health()
        if self.completed==self.requested or self.never_publish or self.ticks%self.period:
            return
        with self._lock_index.get_lock():
            self.stamp(self.slot,self.slot+P,self.requested)
            self.slot+=P;self.accepted+=P
            if self.slot==C:
                self._lock_index[:]=[-1,-1];self.completed=self.requested
            else:self._lock_index[:]=[self.slot,self.slot+P]
    def request_refill(self):
        if self.completed==self.requested:
            self.requested+=1;self.slot=0;self._lock_index[:]=[0,P]
        return self.requested
    def check_health(self):
        if self.fail_at is not None and self.ticks>=self.fail_at:
            raise RuntimeError('controlled producer failure')
    def _require_owner_process(self,name):pass
    def get_flow_status(self):
        self.check_health()
        return dict(requested_generation=self.requested,completed_generation=self.completed,successful_episodes=self.accepted)


class Writer:
    def __init__(self,period):
        self.queue=[];self.period=period;self.ticks=0;self.written=[];self.peak=0
        self.engine=None;self.submitted=[]
    def check_health(self):
        self.ticks+=1
        if self.queue and self.ticks%self.period==0:
            row=self.queue.pop(0);self.written.append(int(row['frame_ids'][0,1]))
    def try_submit(self,packet):
        if len(self.queue)==2:return False
        self.submitted.append((int(packet["frame_ids"][0,1]),int(packet["generations"][0]),self.engine.completed))
        self.queue.append(packet);self.peak=max(self.peak,len(self.queue));return True
    @property
    def stats(self):
        return dict(written_episodes=len(self.written),queue_capacity=2,sdk_write_encode_seconds=len(self.written)*0.001)


class Flow:
    def __init__(self,experiment):self.e=experiment
    def poll(self):self.e.poll();self.e.engine.tick();self.e.engine.check_health()
    def drain_events(self):pass
    def request_refill(self):
        target=self.e.engine.request_refill();self.e.requested(target,time.monotonic());return target
    def wait_for_generation(self,target):
        deadline=time.monotonic()+self.e.args.generation_timeout
        while self.e.engine.completed<target:
            self.poll()
            if time.monotonic()>deadline:raise TimeoutError('controlled generation timeout')


def make(*, updates=12, writer_period=2, eager=False, fail_at=None, never_publish=False):
    root=Path(tempfile.mkdtemp(prefix='ods-publication-cpu-'))
    args=train.build_parser().parse_args(['--output',str(root),'--updates',str(updates),
       '--buffer-size',str(C),'--producer-envs',str(P),'--batch-size',str(B),
       '--episode-budget',str(K),'--prediction-horizon','2','--action-horizon','2',
       '--generation-timeout','0.2','--run-timeout','5',
       '--prefetch-policy','eager' if eager else 'budget'])
    e=train._Experiment(args)
    e.engine=Engine(fail_at=fail_at,never_publish=never_publish)
    e.metadata=describe_raw_buffer(e.engine.shared_buffer)
    e.writer=Writer(writer_period);e.writer.engine=e.engine;e.flow=Flow(e)
    e.raw_refs=[];e.update_publications=[]
    original_register=e.register_episodes
    def register(self,g,rows,stamp):
        self.raw_refs.extend(weakref.ref(row) for row in rows)
        return original_register(g,rows,stamp)
    e.register_episodes=types.MethodType(register,e)
    e.initial_episodes=e.take(1)
    e.stage(e.initial_episodes)
    def update(self,batch,plan,*,requested_ns,generation):
        self.block.mark_trained(plan)
        self.completed_updates+=1
        self.update_completion_ns.append(self.now())
        self.ready_update_seconds.append(0.0001)
        self.trace_updates.append(dict(update=self.completed_updates,generation=generation,pairs=[list(x) for x in plan]))
        self.update_publications.append((generation,self.engine.completed))
        self.check_retention()
    e.update=types.MethodType(update,e)
    return e


def finish(e):
    while e.writer.queue:e.writer.check_health()
    assert e.writer.written==list(range(len(e.registry))),e.writer.written
    assert e.writer.peak<=2
    assert e.peak_owned_episodes<=C
    assert len(e.registry)==e.engine.requested*C
    assert [r['ordinal'] for r in e.registry]==list(range(len(e.registry)))
    assert all(r['trained']<=K and r['reserved']==0 and r['delivered']==r['trained']
               for b in e.retired_ledgers for r in b['episodes'])
    assert sum(b['trained_chunks'] for b in e.retired_ledgers)==e.args.updates*B
    assert e.staging is None and e.block is None and e.packet is None
    gc.collect()
    assert not any(ref() is not None for ref in e.raw_refs),'retired raw references leaked'


def main():
    cases=[]
    e=make(writer_period=5)
    e.overlap_publications();finish(e)
    assert any(g>completed for g,completed in e.update_publications),e.update_publications
    assert len(e.retained_blocks[0]['ordinals'])==C
    assert all(len(r['ordinals'])==P for r in e.retained_blocks[1:])
    cases.append('partial generation trained before completion with bounded C/P blocks and per-source K')
    cases.append('queue<=2, owned raw<=C, completed recording FIFO exact and raw references released')
    trace=copy.deepcopy(dict(retained_blocks=e.retained_blocks,updates=e.trace_updates,
                            generated_generations=e.generation,episodes=e.registry))
    serial=make(writer_period=1)
    serial.serial_trace=trace
    serial.serial_blocks();finish(serial)
    assert serial.retained_blocks==trace['retained_blocks']
    assert all(g<=completed for g,completed in serial.update_publications)
    assert any(g>completed for _,g,completed in serial.writer.submitted),serial.writer.submitted
    cases.append('serial exact boundaries/anchors/digests; recording overlaps generation while all training follows generation completion')
    slow_serial=make(writer_period=5)
    slow_serial.serial_trace=trace
    slow_serial.serial_blocks();finish(slow_serial)
    assert all(g<=completed for g,completed in slow_serial.update_publications)
    assert not slow_serial.ready_episodes
    cases.append('slow-writer serial pool remains bounded, fully recorded, and releases unused tail sources')
    e.normalization_hash='norm';e.initial_model_hash='init'
    recipe={k:getattr(e.args,k) for k in ('vision','seed','updates','batch_size','buffer_size','producer_envs','episode_budget','prediction_horizon')}
    valid_trace={**copy.deepcopy(trace),'format':'ods-visual-training-trace-v2',
                 'recipe':{**recipe,'handoff_mode':e.args.handoff_mode,'encoder_threads':e.args.encoder_threads},
                 'normalization_sha256':'norm','initial_model_sha256':'init'}
    e.serial_trace=copy.deepcopy(valid_trace);e.validate_trace()
    e.serial_trace['recipe']['encoder_threads']+=1
    try:e.validate_trace()
    except ValueError as exc:assert 'recipe' in str(exc)
    else:raise AssertionError('encoder contract mismatch accepted')
    e.serial_trace=copy.deepcopy(valid_trace)
    e.serial_trace['retained_blocks'][1]['ordinals'][0]+=1
    try:e.validate_trace()
    except ValueError as exc:assert 'retained-block' in str(exc)
    else:raise AssertionError('noncontiguous trace sources accepted')
    e.serial_trace={**copy.deepcopy(valid_trace),'format':'ods-visual-training-trace-v1','recipe':recipe}
    del e.serial_trace['retained_blocks']
    e.validate_trace()
    cases.append('v2 validates handoff/encoder/source boundaries; legacy v1 recipe still accepted')

    tail=make(updates=2,eager=True)
    tail.overlap_publications();finish(tail)
    assert len(tail.registry)>len({o for r in tail.trace_updates for o,_ in r['pairs']})
    cases.append('already requested tail generation fully accepted and recorded without training inflation')
    for kwargs,etype,match in [
       ({'never_publish':True},TimeoutError,'Publication'),
       ({'writer_period':100000000},TimeoutError,'Publication'),
       ({'fail_at':5},RuntimeError,'producer failure'),
    ]:
        broken=make(**kwargs)
        try:broken.overlap_publications()
        except etype as exc:assert match in str(exc),str(exc)
        else:raise AssertionError('expected bounded failure')
    cases.append('unpublished data and stalled recording time out; producer failure propagates')
    output=dict(status='passed',cases=cases,overlap_updates=e.update_publications,
                retained_blocks=e.retained_blocks,accepted=len(e.registry),peak_raw=e.peak_owned_episodes,
                tail_accepted=len(tail.registry),serial_exact=True,serial_submissions=serial.writer.submitted,slow_serial_peak_raw=slow_serial.peak_owned_episodes)
    Path('/tmp/ods_publication_training_qualification.json').write_text(json.dumps(output,indent=2))
    print(json.dumps(output,indent=2))


if __name__=='__main__':main()
