from __future__ import annotations

import json
import multiprocessing as mp
import os
import time
from types import SimpleNamespace

import torch
from tensordict import TensorDict

from embodichain.data_pipeline.engine.data import _populate_provenance
from examples.ods.data_stream_demo.acquisition import poll_generation_episodes

C, T, RUN = 4, 6, 17


def stamp(buffer, start, end, generation):
    rows = buffer[start:end]
    rows['valid'].zero_()
    rows['valid'][:, :4] = True
    rows['continuity_id'].fill_(-1)
    rows['continuity_id'][:, :4] = 0
    rows['payload'].fill_(generation * 100 + start)
    _populate_provenance(rows, run_id=RUN, generation=generation,
                         episode_start=(generation-1)*C+start,
                         accepted_at_ns=99, published_monotonic_ns=101)


def producer(buffer, cursor, progress, command, response, failed):
    with cursor.get_lock():
        cursor[:] = [0, 2]
    response.put('writing')
    assert command.get(timeout=10) == 'publish'
    with cursor.get_lock():
        stamp(buffer, 0, 2, 2)
        cursor[:] = [2, 4]
    response.put('partial')
    assert command.get(timeout=10) == 'finish'
    with cursor.get_lock():
        stamp(buffer, 2, 4, 2)
        cursor[:] = [-1, -1]
    with progress.get_lock():
        progress[1] = 2
    response.put('complete')
    assert command.get(timeout=10) == 'hold'
    with cursor.get_lock():
        response.put('locked')
        assert command.get(timeout=10) == 'release'
    failed.set()
    response.put('failed')


class Engine:
    buffer_size = C
    run_id = RUN

    def __init__(self, ctx):
        self.owner_pid = os.getpid()
        self._lock_index = ctx.Array('i', [-1,-1])
        self.progress = ctx.Array('i', [2,1])
        self.failure = ctx.Event()
        fields = {
            'valid': torch.zeros(C,T,dtype=torch.bool),
            'continuity_id': torch.zeros(C,T,dtype=torch.int64),
            'payload': torch.zeros(C,T,2),
        }
        for key in ('ods_run_id','ods_episode_id','ods_generation','ods_frame_index',
                    'ods_accepted_at_ns','ods_published_at_monotonic_ns'):
            fields[key] = torch.full((C,T),-1,dtype=torch.int64)
        self.shared_buffer = TensorDict(fields, batch_size=[C,T]).share_memory_()
        stamp(self.shared_buffer,0,C,1)

    def _require_owner_process(self, name):
        if self.owner_pid != os.getpid():
            raise RuntimeError("owner process required")

    def check_health(self):
        if self.failure.is_set():
            raise RuntimeError('qualification worker failure')

    def get_flow_status(self):
        self.check_health()
        with self.progress.get_lock():
            return dict(requested_generation=self.progress[0], completed_generation=self.progress[1])


def raises(fn, cls, match):
    try:
        fn()
    except cls as exc:
        assert match in str(exc), str(exc)
    else:
        raise AssertionError('exception missing')


def main():
    ctx = mp.get_context('spawn')
    e = Engine(ctx)
    cmd, rsp = ctx.Queue(), ctx.Queue()
    p = ctx.Process(target=producer,args=(e.shared_buffer,e._lock_index,e.progress,cmd,rsp,e.failure))
    p.start()
    receipts=[]
    try:
        assert rsp.get(timeout=30) == 'writing'
        assert poll_generation_episodes(e,2,4,max_count=C) == []
        cmd.put('publish')
        assert rsp.get(timeout=10) == 'partial'
        first = poll_generation_episodes(e,2,4,max_count=1)
        assert len(first)==1 and first[0].batch_size == (4,)
        assert first[0]['ods_episode_id'].tolist() == [4]*4
        second = poll_generation_episodes(e,2,5,max_count=C)
        assert len(second)==1 and second[0]['ods_episode_id'].tolist()==[5]*4
        assert e.progress[1]==1
        assert poll_generation_episodes(e,2,6,max_count=C)==[]
        receipts.append('ordered bounded subbatch visible before generation completion')
        cmd.put('finish')
        assert rsp.get(timeout=10) == 'complete'
        tail = poll_generation_episodes(e,2,6,max_count=C)
        assert [int(x['ods_episode_id'][0]) for x in tail]==[6,7]
        assert poll_generation_episodes(e,2,2*C,max_count=C)==[]
        with e._lock_index.get_lock():
            e.shared_buffer['payload'].fill_(-99)
        assert (first[0]['payload']==200).all()
        assert (second[0]['payload']==200).all()
        receipts.append('complete traversal has exact IDs 4,5,6,7 and independent snapshots')
        cmd.put('hold')
        assert rsp.get(timeout=10)=='locked'
        start=time.monotonic()
        assert poll_generation_episodes(e,2,4,max_count=C)==[]
        elapsed=time.monotonic()-start
        assert elapsed<0.1,elapsed
        receipts.append('contended publication lock returns without waiting')
        cmd.put('release')
        assert rsp.get(timeout=10)=='failed'
        raises(lambda:poll_generation_episodes(e,2,4,max_count=C),RuntimeError,'worker failure')
        receipts.append('worker failure is terminal rather than unavailable')
    finally:
        if p.is_alive():
            p.join(timeout=5)
        if p.is_alive():
            p.terminate(); p.join(timeout=5)
        assert not p.is_alive()
        assert p.exitcode==0,p.exitcode
        cmd.close();rsp.close();cmd.join_thread();rsp.join_thread()
    e.failure.clear()
    for key,value,match in [
        ('valid',True,'valid prefix'),
        ('continuity_id',1,'continuity'),
        ('ods_episode_id',999,'publication identity'),
        ('ods_generation',1,'publication identity'),
        ('ods_run_id',999,'publication identity'),
        ('ods_frame_index',99,'frame ordering'),
    ]:
        stamp(e.shared_buffer,0,C,2)
        index=5 if key=='valid' else 2
        e.shared_buffer[key][0,index]=value
        raises(lambda:poll_generation_episodes(e,2,4,max_count=1),ValueError,match)
    receipts.append('dirty tails, continuity and run/generation/episode/frame corruption rejected')
    stamp(e.shared_buffer,0,C,1)
    raises(lambda:poll_generation_episodes(e,2,4,max_count=1),RuntimeError,'not retained')
    e.progress[0]=3
    raises(lambda:poll_generation_episodes(e,2,4,max_count=1),RuntimeError,'newer refill')
    receipts.append('lost publication and later refill explicitly rejected')
    e.progress[0] = 2
    stamp(e.shared_buffer,0,C,2)
    e._lock_index[:] = [0,2]
    assert len(poll_generation_episodes(e,2,6,max_count=2)) == 2
    assert poll_generation_episodes(e,2,4,max_count=2) == []
    e._lock_index[:] = [-1,-1]
    e.owner_pid = -1
    raises(lambda:poll_generation_episodes(e,2,4,max_count=2),RuntimeError,'owner process')
    e.owner_pid = os.getpid()
    receipts.append('wrapped write mask excludes only overlapping slots; nonowner rejected')
    for args in [(True,0,1),(2,-1,1),(2,2*C+1,1),(2,0,-1)]:
        raises(lambda:poll_generation_episodes(e,args[0],args[1],max_count=args[2]),ValueError,'must')
    receipts.append('invalid ordinal, generation and count rejected')
    result={'status':'passed','cases':receipts,'lock_poll_seconds':elapsed,'worker_exitcode':p.exitcode}
    with open('/tmp/ods_incremental_acquisition_qualification.json','w') as stream:
        json.dump(result,stream,indent=2)
    print(json.dumps(result,indent=2))


if __name__=='__main__':
    main()
