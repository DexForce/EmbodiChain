"""Independent CPU evidence receipts for terminal calibration/pilot attempts.

Reuses the previous study's trusted reconstruction/checkpoint/video bindings.
Default inspect does not load checkpoints or hash corpora. --execute is reserved
for an explicit post-pilot trigger; failed attempts retain their qualification.
No recording is changed, no policy is run, and no video is decoded.
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
from pathlib import Path
import tempfile
from typing import Any

__all__ = ["main"]

ROOT = Path("/root/sources/EmbodiChain-ods-stream-design")
SHARED = (
    ROOT
    / "examples/ods/data_stream_demo/results/2026-10-21-visual-training/independent_audit.py"
)
BUDGET = ("updates", "batch_size", "history_length", "prediction_horizon")
TERMINAL = {"complete", "failed", "unsupported"}


def read(path: Path) -> dict[str, Any]:
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError(f"Not a JSON object: {path}")
    return value


def shared_module() -> Any:
    spec = importlib.util.spec_from_file_location(
        "trusted_ods_independent_audit", SHARED
    )
    assert spec is not None and spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def discover(roots: list[Path], pilot_roots: list[Path]) -> list[dict[str, Any]]:
    found = {}
    for root in roots:
        for path in sorted(root.rglob("summary.json")):
            summary = read(path)
            config_path = path.parent / "config.json"
            config = (
                read(config_path)
                if config_path.is_file()
                else summary.get("config", {})
            )
            if config.get("arm") not in {
                "offline",
                "ods_overlap",
                "ods_serial",
            } or not all(k in config for k in BUDGET):
                continue
            found[str(path.resolve())] = {
                "directory": path.parent.resolve(),
                "summary": summary,
                "config": config,
                "pilot": any(path.resolve().is_relative_to(p) for p in pilot_roots),
            }
    return list(found.values())


def evaluation_errors(
    directory: Path,
    summary: dict[str, Any],
    config: dict[str, Any],
    final_sha: str | None,
) -> list[str]:
    errors = []
    count = summary.get("requested_evaluation_scenes")
    configured = config.get("evaluation_scenes", 0)
    if type(count) is not int or count < 0:
        return ["supervisor requested evaluation count is missing or invalid"]
    # The supervisor deliberately passes --evaluation-scenes 0 to training
    # workers; independent evaluation belongs to the outer stage lifecycle.
    if (
        type(configured) is not int
        or configured < 0
        or (
            configured != count
            and not (config.get("worker") is True and configured == 0)
        )
    ):
        errors.append("evaluation request differs from configured lifecycle")
    if count == 0:
        if (
            summary.get("evaluation_status") != "not_requested"
            or summary.get("evaluation")
            or (directory / "evaluation.json").exists()
            or (directory / "evaluation-process.json").exists()
        ):
            errors.append(
                "zero-evaluation run must remain not_requested with no evaluation artifacts"
            )
    else:
        value = summary.get("evaluation", {})
        if not (
            summary.get("evaluation_status") == "complete"
            and value.get("passed") is True
            and value.get("closed") is True
            and value.get("scenes") == count
            and len(value.get("records", [])) == count
            and value.get("policy_step") == config["updates"]
            and value.get("seed") == 197001
            and value.get("expert_initialized") is False
            and value.get("checkpoint_sha256") == final_sha
        ):
            errors.append(
                "requested independent evaluation did not complete its contract"
            )
        if (
            not (directory / "evaluation.json").is_file()
            or read(directory / "evaluation.json") != value
        ):
            errors.append("inline evaluation differs from retained receipt")
    return errors


def process_errors(path: Path, *, stage: str) -> list[str]:
    if not path.is_file():
        return [f"missing {stage} process receipt"]
    value = read(path)
    shutdown = value.get("process_group_shutdown", {})
    final = shutdown.get("final", {})
    if not (
        value.get("returncode") == 0
        and value.get("stage") == stage
        and all(
            value.get(k) is False
            for k in ("timeout", "cancelled", "leaked_process_group")
        )
        and shutdown.get("group_disappeared") is True
        and final.get("exists") is False
        and final.get("members") == []
        and value.get("device_guard", {}).get("unexpected_contexts") == []
    ):
        return [f"{stage} process did not establish normal empty-group closure"]
    return []


def canonical(trace: dict[str, Any], *, trained_only: bool) -> list[list[Any]]:
    used = {pair[0] for row in trace["updates"] for pair in row["pairs"]}
    return [
        [row[k] for k in ("ordinal", "generation", "length", "numeric_sha256")]
        for row in trace["episodes"]
        if not trained_only or row["ordinal"] in used
    ]


def protocol_evidence(protocol: Path | None, lib: Any) -> dict[str, Any] | None:
    if protocol is None:
        return None
    value = read(protocol)
    expected = value["source_sha256"] | value.get("additional_source_sha256", {})
    errors = []
    for name, sha in expected.items():
        for location in (
            ROOT / name,
            protocol.parent / "frozen-source" / (name + ".source"),
        ):
            if not location.is_file() or lib.digest(location) != sha:
                errors.append(str(location))
    return {
        "passed": not errors,
        "errors": errors,
        "path": str(protocol),
        "sha256": lib.digest(protocol),
        "implementation_commit": value.get("implementation_commit"),
        "source_files": len(expected),
    }


def run_source_evidence(
    directory: Path, roots: list[Path], expected: dict[str, str]
) -> dict[str, Any]:
    for parent in (directory, *directory.parents):
        if not any(parent.is_relative_to(root) for root in roots):
            break
        path = parent / "suite-summary.json"
        if path.is_file():
            suite = read(path)
            return {
                "passed": suite.get("source_sha256") == expected,
                "suite_path": str(path),
                "suite_status": suite.get("status"),
                "source_files": len(suite.get("source_sha256", {})),
            }
    return {"passed": False, "error": "no retained supervising suite source manifest"}


def audit_one(run: dict[str, Any], lib: Any) -> dict[str, Any]:
    directory, summary, config = run["directory"], run["summary"], run["config"]
    complete = summary.get("status") == "complete"
    row = {
        "path": str(directory),
        "pilot": run["pilot"],
        "status": summary.get("status"),
        "original_qualification_passed": summary.get("qualification_passed"),
        "config": {
            k: config.get(k)
            for k in (
                *BUDGET,
                "arm",
                "vision",
                "seed",
                "producer_envs",
                "buffer_size",
                "episode_budget",
                "prefetch_policy",
                "evaluation_scenes",
            )
        },
        "eligible_for_comparison": False,
        "errors": [],
        "failure_details": {
            k: summary.get(k)
            for k in (
                "error",
                "quality_error",
                "supervisor_error",
                "post_audit_status",
                "evaluation_status",
            )
        },
    }
    errors = row["errors"]
    metrics = summary.get("training_metrics", {})
    if metrics and (directory / "training-events.jsonl").is_file():
        try:
            row["event_reconstruction"] = lib.reconstruct_metrics(directory)
            if not row["event_reconstruction"]["passed"]:
                errors.append("independent event reconstruction failed")
        except Exception as error:
            errors.append("event reconstruction: " + repr(error))
    elif complete:
        errors.append("completed attempt lacks event reconstruction inputs")
    checkpoints = {}
    for name in ("initial", "final"):
        path = directory / (name + ".pt")
        if path.is_file():
            try:
                checkpoints[name] = lib.checkpoint_model_hash(path)
            except Exception as error:
                errors.append(name + " checkpoint: " + repr(error))
    row["checkpoints"] = checkpoints
    raw_audit = (
        read(directory / "post-audit.json")
        if (directory / "post-audit.json").is_file()
        else {}
    )
    if raw_audit.get("passed") is True and metrics:
        view = dict(summary, post_audit=raw_audit)
        row["full_video_evidence"] = lib.full_video_evidence(directory, view)
        if not row["full_video_evidence"]["passed"]:
            errors.append("full-video retained bytes disagree")
    if complete:
        initial, final = checkpoints.get("initial", {}), checkpoints.get("final", {})
        expected = {
            "completed_updates": config["updates"],
            "trained_chunks": config["updates"] * config["batch_size"],
            "valid_target_occurrences": config["updates"]
            * config["batch_size"]
            * config["prediction_horizon"],
        }
        if not (directory / "config.json").is_file() or any(
            summary.get("config", {}).get(k) != config.get(k)
            for k in (*BUDGET, "arm", "vision", "seed", "evaluation_scenes")
        ):
            errors.append("retained config and embedded summary config differ")
        if not all(type(config.get(k)) is int and config[k] > 0 for k in BUDGET):
            errors.append("invalid configured U/B/H/F")
        if any(metrics.get(k) != v for k, v in expected.items()) or (
            metrics.get("batch_size"),
            metrics.get("history"),
            metrics.get("future"),
        ) != (
            config["batch_size"],
            config["history_length"],
            config["prediction_horizon"],
        ):
            errors.append("completed work/sequence schema differs from per-run config")
        if summary.get("qualification_passed") is not True:
            errors.append("complete attempt did not retain passed qualification")
        if not (
            initial.get("step") == 0
            and initial.get("optimizer_steps") == []
            and initial.get("model_sha256") == metrics.get("initial_model_sha256")
            and final.get("step") == config["updates"]
            and final.get("optimizer_steps") == [config["updates"]]
            and final.get("model_sha256") == metrics.get("final_model_sha256")
            and final.get("model_sha256") != initial.get("model_sha256")
            and initial.get("normalization_sha256")
            == final.get("normalization_sha256")
            == metrics.get("normalization_sha256")
        ):
            errors.append(
                "initial/final weights, normalization or optimizer steps differ"
            )
        contract = read(directory / "initial-contract.json")
        if contract.get("model_sha256") != initial.get("model_sha256") or contract.get(
            "normalization_sha256"
        ) != initial.get("normalization_sha256"):
            errors.append("initial model/normalization differs from initial contract")
        if not (
            summary.get("post_audit_status") == "complete"
            and raw_audit == summary.get("post_audit")
            and raw_audit.get("passed") is True
            and raw_audit.get("recording", {}).get("episodes")
            == metrics.get("published_sources")
            and raw_audit.get("decode", {}).get("episodes")
            == metrics.get("published_sources")
            and raw_audit.get("recording", {}).get("all_numeric_sha256_verified")
            is True
            and raw_audit.get("training", {}).get("checkpoint_verified") is True
            and row.get("full_video_evidence", {}).get("passed") is True
        ):
            errors.append("post-audit/full-video contract incomplete")
        sidecar = directory / "post-audit-video-integrity.json"
        if not sidecar.is_file() or read(sidecar) != raw_audit.get(
            "full_video_integrity"
        ):
            errors.append("full-video inline/sidecar mismatch")
        errors.extend(
            evaluation_errors(directory, summary, config, final.get("file_sha256"))
        )
        stages = [("process.json", "training"), ("audit-process.json", "audit")]
        if summary.get("requested_evaluation_scenes", 0) > 0:
            stages.append(("evaluation-process.json", "evaluation"))
        for filename, stage in stages:
            errors.extend(process_errors(directory / filename, stage=stage))
        process = read(directory / "process.json")
        if not lib.equivalent(
            process.get("elapsed_seconds"), metrics.get("total_seconds")
        ):
            errors.append("supervisor and reported total time differ")
        row["expected_completed_work"] = expected
    else:
        row["qualification_preserved"] = summary.get("qualification_passed") is False
        if not row["qualification_preserved"]:
            errors.append("failed/unsupported attempt was not kept unqualified")
    row["evidence_consistent"] = not errors
    row["eligible_for_comparison"] = complete and not errors
    return row


def file_inventory(directory: Path, lib: Any) -> list[dict[str, Any]]:
    result = []
    paths = {p for p in (directory / "lerobot_dataset").rglob("*") if p.is_file()}
    paths.update(
        p
        for p in directory.iterdir()
        if p.is_file()
        and (
            p.suffix == ".pt"
            or p.name
            in {
                "summary.json",
                "config.json",
                "training-events.jsonl",
                "training-trace.json",
                "initial-contract.json",
                "post-audit.json",
                "post-audit-video-integrity.json",
                "process.json",
                "audit-process.json",
                "evaluation.json",
                "evaluation-process.json",
            }
        )
    )
    for path in sorted(paths):
        result.append(
            {
                "run": str(directory),
                "path": str(path.absolute()),
                "resolved_path": str(path.resolve()),
                "bytes": path.stat().st_size,
                "sha256": lib.digest(path),
            }
        )
    return result


def pair_runs(
    runs: list[dict[str, Any]], rows: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    eligible = {row["path"] for row in rows if row["eligible_for_comparison"]}
    candidates = [
        run for run in runs if run["pilot"] and str(run["directory"]) in eligible
    ]
    results = []
    budgets = [
        run
        for run in runs
        if run["pilot"]
        and run["config"]["arm"] == "ods_overlap"
        and run["config"].get("prefetch_policy", "budget") == "budget"
    ]
    if any(run["pilot"] for run in runs) and not budgets:
        return [
            {"passed": False, "errors": ["pilot input has no budget-overlap attempt"]}
        ]
    for budget in budgets:
        a = budget["config"]
        if a["arm"] != "ods_overlap" or a.get("prefetch_policy", "budget") != "budget":
            continue
        if str(budget["directory"]) not in eligible:
            results.append(
                {
                    "kind": "pilot_pairing",
                    "budget_path": str(budget["directory"]),
                    "passed": False,
                    "errors": [
                        "budget attempt remains unqualified; comparison unavailable"
                    ],
                }
            )
            continue
        group = lambda c: tuple(
            c.get(k)
            for k in (
                "vision",
                "seed",
                *BUDGET,
                "buffer_size",
                "producer_envs",
                "episode_budget",
            )
        )
        for label in ("eager", "serial"):
            matches = [
                run
                for run in candidates
                if group(run["config"]) == group(a)
                and (
                    run["config"]["arm"] == "ods_serial"
                    if label == "serial"
                    else run["config"]["arm"] == "ods_overlap"
                    and run["config"].get("prefetch_policy") == "eager"
                )
            ]
            if not matches:
                results.append(
                    {
                        "kind": label,
                        "budget_path": str(budget["directory"]),
                        "passed": False,
                        "errors": [
                            "no qualified matching pilot control; failed attempts remain excluded"
                        ],
                    }
                )
            for other in matches:
                left, right = (
                    read(run["directory"] / "training-trace.json")
                    for run in (budget, other)
                )
                x, y = (run["summary"]["training_metrics"] for run in (budget, other))
                trained = label == "eager"
                checks = {
                    "initial_model_equal": x["initial_model_sha256"]
                    == y["initial_model_sha256"],
                    "normalization_equal": x["normalization_sha256"]
                    == y["normalization_sha256"],
                    "ordered_update_trace_equal": left["updates"] == right["updates"],
                    "numeric_manifest_equal_excluding_run_id": canonical(
                        left, trained_only=trained
                    )
                    == canonical(right, trained_only=trained),
                    "work_equal": all(
                        x[k] == y[k]
                        for k in (
                            "completed_updates",
                            "trained_chunks",
                            "valid_target_occurrences",
                        )
                    ),
                }
                if trained:
                    checks["trained_32_sources_each"] = (
                        x["trained_sources"] == y["trained_sources"] == 32
                    )
                results.append(
                    {
                        "kind": label,
                        "budget_path": str(budget["directory"]),
                        "control_path": str(other["directory"]),
                        "passed": all(checks.values()),
                        "checks": checks,
                        "accepted_sources": [
                            x["published_sources"],
                            y["published_sources"],
                        ],
                        "untrained_tail_sources": [
                            x["untrained_sources"],
                            y["untrained_sources"],
                        ],
                        "final_model_sha_equal_diagnostic_only": x["final_model_sha256"]
                        == y["final_model_sha256"],
                        "raw_rgb_equivalence": "unknown; numeric/order matching and retained video evidence do not establish complete model-input RGB identity",
                    }
                )
    return results


def self_test(lib: Any) -> dict[str, Any]:
    with tempfile.TemporaryDirectory(prefix="ods-budget-audit-selftest-") as tmp:
        path = Path(tmp)
        config = {"evaluation_scenes": 0, "updates": 7}
        summary = {
            "requested_evaluation_scenes": 0,
            "evaluation_status": "not_requested",
        }
        assert evaluation_errors(path, summary, config, None) == []
        assert evaluation_errors(
            path, summary | {"evaluation_status": "pending"}, config, None
        )
        assert process_errors(path / "absent.json", stage="audit")
        left = {
            "updates": [{"pairs": [[0, 1]]}],
            "episodes": [
                {
                    "ordinal": 0,
                    "generation": 0,
                    "length": 40,
                    "numeric_sha256": "n",
                    "source_id": [1, 0],
                },
                {
                    "ordinal": 1,
                    "generation": 1,
                    "length": 40,
                    "numeric_sha256": "tail",
                    "source_id": [1, 1],
                },
            ],
        }
        right = json.loads(json.dumps(left))
        right["episodes"][0]["source_id"][0] = 999
        right["episodes"][1]["numeric_sha256"] = "unused-other"
        assert canonical(left, trained_only=True) == canonical(right, trained_only=True)
        assert canonical(left, trained_only=False) != canonical(
            right, trained_only=False
        )
    inventory = []
    directory = Path("/tmp/ods-normal-exit-grace-physical-20261021-v1")
    summary = read(directory / "summary.json")
    actual = audit_one(
        {
            "directory": directory,
            "summary": summary,
            "config": read(directory / "config.json"),
            "pilot": False,
        },
        lib,
    )
    inventory = file_inventory(directory, lib)
    assert actual["eligible_for_comparison"], actual["errors"]
    assert actual["expected_completed_work"] == {
        "completed_updates": 4,
        "trained_chunks": 16,
        "valid_target_occurrences": 512,
    }
    return {
        "passed": True,
        "metadata_fail_closed_cases": 4,
        "real_prior_small_fixture": actual,
        "prior_fixture_inventory_files": len(inventory),
        "scope": "Self-qualification only; no current calibration or pilot checkpoints/corpora were read",
    }


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, action="append", default=[])
    parser.add_argument("--pilot-root", type=Path, action="append", default=[])
    parser.add_argument("--protocol", type=Path)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--execute", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    roots = [p.resolve() for p in args.root]
    pilots = [p.resolve() for p in args.pilot_root]
    if any(not p.is_dir() for p in roots + pilots):
        parser.error("Every specified input root must exist")
    if any(not any(p.is_relative_to(root) for root in roots) for p in pilots):
        parser.error("Every pilot root must be included in an input root")
    runs = discover(roots, pilots)
    if not args.execute and not args.self_test:
        print(
            json.dumps(
                {
                    "mode": "inspect_only",
                    "runs": [
                        {
                            "path": str(run["directory"]),
                            "status": run["summary"].get("status"),
                            "pilot": run["pilot"],
                        }
                        for run in runs
                    ],
                    "no_checkpoint_or_corpus_hashing": True,
                },
                indent=2,
            )
        )
        return
    if (
        args.output is None
        or args.output.exists()
        or any(args.output.resolve().is_relative_to(p) for p in roots)
    ):
        parser.error("Use a fresh output JSON outside the input roots")
    os.environ.update(
        CUDA_VISIBLE_DEVICES="",
        OMP_NUM_THREADS="1",
        MKL_NUM_THREADS="1",
        OPENBLAS_NUM_THREADS="1",
    )
    lib = shared_module()
    if args.self_test:
        result = self_test(lib)
        proof = protocol_evidence(args.protocol, lib)
        result["source_protocol"] = proof
        result["passed"] = result["passed"] and (proof is None or proof["passed"])
    else:
        if not runs or any(
            run["summary"].get("status") not in TERMINAL for run in runs
        ):
            parser.error("Only terminal per-run summaries can be audited")
        if any(
            run["summary"].get("status") == "complete"
            and (
                run["summary"].get("post_audit_status") != "complete"
                or run["summary"].get("evaluation_status")
                not in {"complete", "not_requested"}
            )
            for run in runs
        ):
            parser.error("A completed training process still awaits post-run stages")
        inventory = []
        rows = []
        protocol_value = read(args.protocol) if args.protocol is not None else None
        for run in runs:
            try:
                rows.append(audit_one(run, lib))
            except Exception as error:
                rows.append(
                    {
                        "path": str(run["directory"]),
                        "status": run["summary"].get("status"),
                        "original_qualification_passed": run["summary"].get(
                            "qualification_passed"
                        ),
                        "eligible_for_comparison": False,
                        "evidence_consistent": False,
                        "errors": [repr(error)],
                    }
                )
            if protocol_value is not None:
                evidence = run_source_evidence(
                    run["directory"], roots, protocol_value["source_sha256"]
                )
                rows[-1]["suite_source_provenance"] = evidence
                if (
                    run["summary"].get("status") == "complete"
                    and not evidence["passed"]
                ):
                    rows[-1]["errors"].append(
                        "run suite source manifest differs from frozen protocol"
                    )
                    rows[-1].update(
                        evidence_consistent=False, eligible_for_comparison=False
                    )
            try:
                inventory.extend(file_inventory(run["directory"], lib))
            except Exception as error:
                rows[-1]["errors"].append("artifact inventory: " + repr(error))
                rows[-1].update(
                    evidence_consistent=False, eligible_for_comparison=False
                )
        pairs = pair_runs(runs, rows)
        protocol = protocol_evidence(args.protocol, lib)
        inventory_path = args.output.with_name(args.output.stem + "-inventory.json")
        if inventory_path.exists():
            parser.error("Use a fresh inventory output path")
        inventory_path.parent.mkdir(parents=True, exist_ok=True)
        inventory_path.write_text(json.dumps(inventory, indent=2) + "\n")
        result = {
            "passed": all(row["evidence_consistent"] for row in rows)
            and all(pair["passed"] for pair in pairs)
            and (protocol is None or protocol["passed"]),
            "scope": __doc__,
            "protocol": protocol,
            "attempts": rows,
            "pairs": pairs,
            "original_status_counts": {
                status: sum(row["status"] == status for row in rows)
                for status in sorted(TERMINAL)
            },
            "failed_attempts_never_promoted": all(
                not row["eligible_for_comparison"]
                for row in rows
                if row["status"] != "complete"
            ),
            "external_inventory": {
                "path": str(inventory_path.resolve()),
                "sha256": lib.digest(inventory_path),
                "files": len(inventory),
                "bytes": sum(row["bytes"] for row in inventory),
            },
        }
    result.update(
        driver_sha256=lib.digest(Path(__file__)),
        shared_audit_path=str(SHARED),
        shared_audit_sha256=lib.digest(SHARED),
    )
    args.output.parent.mkdir(parents=True, exist_ok=True)
    with args.output.open("x") as stream:
        json.dump(result, stream, indent=2, allow_nan=False)
        stream.write("\n")
    print(
        json.dumps({"passed": result["passed"], "receipt": str(args.output)}),
        flush=True,
    )
    raise SystemExit(0 if result["passed"] else 1)


if __name__ == "__main__":
    main()
