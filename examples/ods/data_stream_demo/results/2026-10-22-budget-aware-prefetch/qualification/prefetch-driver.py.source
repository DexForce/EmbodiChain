"""CPU engineering checks of actual prefetch methods; no simulated performance.

AST extracts the current private decision, prefetch and overlap methods plus the
real BalancedAnchorSampler. Controlled actors only provide deterministic supply
readiness and acknowledgement events. There is no model, fake optimizer load,
sleep-based speed comparison, simulation, rendering or throughput claim.
"""

from __future__ import annotations

import argparse
import ast
from collections import Counter
import copy
import hashlib
import json
import math
import os
from pathlib import Path
from types import SimpleNamespace
from typing import Any
import traceback

__all__ = ["main"]

ROOT = Path("/root/sources/EmbodiChain-ods-stream-design")


def load() -> tuple[dict[str, Any], dict[str, str]]:
    import torch

    torch.set_num_threads(1)
    scope: dict[str, Any] = {
        "Any": Any,
        "math": math,
        "copy": copy,
        "Counter": Counter,
        "torch": torch,
    }
    files = {
        "train": ROOT / "examples/ods/data_stream_demo/train.py",
        "sampler": ROOT / "examples/ods/data_stream_demo/training_data.py",
    }
    contents = {key: path.read_bytes() for key, path in files.items()}
    trees = {key: ast.parse(data) for key, data in contents.items()}
    decision = next(
        n
        for n in trees["train"].body
        if isinstance(n, ast.FunctionDef) and n.name == "_prefetch_decision"
    )
    experiment = next(
        n
        for n in trees["train"].body
        if isinstance(n, ast.ClassDef) and n.name == "_Experiment"
    )
    methods = [
        n
        for n in experiment.body
        if isinstance(n, ast.FunctionDef) and n.name in ("prefetch", "overlap")
    ]
    sampler = next(
        n
        for n in trees["sampler"].body
        if isinstance(n, ast.ClassDef) and n.name == "BalancedAnchorSampler"
    )
    assert len(methods) == 2
    future = ast.parse("from __future__ import annotations").body
    exec(
        compile(
            ast.Module(body=future + [decision, sampler] + methods, type_ignores=[]),
            "<actual-prefetch-functions>",
            "exec",
        ),
        scope,
    )
    return scope, {
        key: hashlib.sha256(data).hexdigest() for key, data in contents.items()
    }


def records(generation: int) -> list[dict[str, Any]]:
    return [
        {
            "ordinal": generation * 8 + i,
            "length": 64,
            "source_id": [4242, generation * 8 + i],
        }
        for i in range(8)
    ]


def decision_cases(scope: dict[str, Any]) -> dict[str, Any]:
    base = dict(
        remaining_updates=3,
        batch_size=32,
        remaining_credits=96,
        handoff_seconds=1.0,
        update_seconds=1.0,
        policy="budget",
    )
    cases = [
        ("budget_done", {"remaining_updates": 0, "remaining_credits": 0}, False, None),
        ("unknown_timing_funded", {"handoff_seconds": None}, False, None),
        ("unknown_update_funded", {"update_seconds": None}, False, None),
        (
            "unknown_timing_quota",
            {"remaining_credits": 95, "handoff_seconds": None, "update_seconds": None},
            True,
            "quota_required",
        ),
        (
            "last_batch_funded",
            {"remaining_updates": 1, "remaining_credits": 32},
            False,
            None,
        ),
        (
            "last_batch_partial_credits",
            {"remaining_updates": 1, "remaining_credits": 31, "handoff_seconds": None},
            True,
            "quota_required",
        ),
        ("handoff_strictly_before_window", {"handoff_seconds": 1.999}, True, None),
        ("handoff_equals_window", {"handoff_seconds": 2.0}, False, None),
        ("handoff_after_window", {"handoff_seconds": 2.001}, False, None),
        (
            "eager_unknown_funded",
            {"policy": "eager", "handoff_seconds": None, "update_seconds": None},
            True,
            None,
        ),
        (
            "eager_last_funded",
            {"policy": "eager", "remaining_updates": 1, "remaining_credits": 32},
            False,
            None,
        ),
        (
            "fast_refresh_without_quota_need",
            {"remaining_updates": 8, "remaining_credits": 1024, "handoff_seconds": 0.1},
            True,
            None,
        ),
    ]
    results = []
    for label, changes, request, reason in cases:
        args = base | changes
        before = copy.deepcopy(args)
        result = scope["_prefetch_decision"](**args)
        assert type(result["request"]) is bool and result["request"] is request, (
            label,
            result,
        )
        assert isinstance(result["reason"], str) and result["reason"]
        if reason is not None:
            assert result["reason"] == reason, (label, result)
        assert args == before
        assert result["remaining_updates"] == args["remaining_updates"]
        assert result["remaining_credits"] == args["remaining_credits"]
        expected_window = (
            None
            if args["update_seconds"] is None
            else max(0, args["remaining_updates"] - 1) * args["update_seconds"]
        )
        assert result["remaining_refresh_window_seconds"] == expected_window
        results.append({"case": label, "result": result})
    invalid = [
        {"remaining_updates": -1},
        {"batch_size": 0},
        {"remaining_credits": -1},
        {"remaining_updates": True},
        {"policy": "unknown"},
        {"handoff_seconds": -1.0},
        {"update_seconds": 0.0},
        {"handoff_seconds": float("nan")},
        {"update_seconds": float("inf")},
        {"handoff_seconds": True},
    ]
    for changes in invalid:
        try:
            scope["_prefetch_decision"](**(base | changes))
        except (ValueError, TypeError):
            pass
        else:
            raise AssertionError("Invalid decision input accepted: " + repr(changes))
    return {"valid_cases": results, "invalid_cases_rejected": len(invalid)}


class Flow:
    def __init__(self, host: SimpleNamespace, duration: float) -> None:
        self.host, self.duration = host, duration
        self.pending: int | None = None
        self.ready_at = 0.0
        self.requests: list[int] = []

    def request_refill(self) -> int:
        assert self.pending is None, "Actual caller duplicated a pending request"
        self.pending = self.host.generation + 1
        self.ready_at = self.host.clock + self.duration
        self.requests.append(self.pending)
        return self.pending

    def poll(self) -> None:
        self.host.poll_count += 1
        assert self.host.poll_count < 10000, "Actual caller stopped making progress"

    def wait_for_generation(self, generation: int) -> None:
        assert generation == self.pending
        self.host.clock = max(self.host.clock, self.ready_at)

    def get_flow_status(self) -> dict[str, int]:
        done = (
            self.pending
            if self.pending is not None and self.host.clock >= self.ready_at
            else self.host.generation
        )
        return {"completed_generation": done}


class Block:
    def __init__(self, sampler: Any) -> None:
        self.sampler = sampler

    def next_plan(self, count: int) -> list[tuple[int, int]]:
        return self.sampler.reserve(count)

    def materialize(self, plan: list[tuple[int, int]]) -> dict[str, Any]:
        self.sampler.mark_delivered(plan)
        return {"plan": plan}


def caller_case(
    scope: dict[str, Any], *, policy: str, updates: int, cap: int, supply_seconds: float
) -> dict[str, Any]:
    host = SimpleNamespace(
        args=SimpleNamespace(
            updates=updates, batch_size=32, episode_budget=cap, prefetch_policy=policy
        ),
        initial_episodes=records(0),
        block=None,
        generation=0,
        completed_updates=0,
        clock=0.0,
        poll_count=0,
        staging=None,
        registry=records(0),
        ready_update_seconds=[],
        generation_seconds=[supply_seconds],
        snapshot_seconds=[0.01],
        last_prefetch_decision=None,
    )
    host.events = []
    host.metrics = SimpleNamespace(
        event=lambda kind, stamp, **kwargs: host.events.append(
            {"kind": kind, **kwargs}
        ),
        interval=lambda *args, **kwargs: None,
    )
    host.now = lambda: int(host.clock * 1e9) + 1
    host.writer = SimpleNamespace(
        stats={
            "written_episodes": 0,
            "queue_capacity": 2,
            "sdk_write_encode_seconds": 0.0,
        }
    )
    host.flow = Flow(host, supply_seconds)
    host.engine = host.flow
    host.retired = []
    host.old_samplers = []
    host.plan_trace = []
    host.untrained_tail_sources = 0

    def install(rows: list[dict[str, Any]], *, record: bool = True) -> None:
        host.block = Block(
            scope["BalancedAnchorSampler"](
                rows, episode_budget=cap, seed=29001 + host.generation
            )
        )

    def take(generation: int, *, drain: bool = False) -> list[dict[str, Any]]:
        host.flow.wait_for_generation(generation)
        host.flow.pending = None
        host.generation = generation
        host.generation_seconds.append(supply_seconds)
        host.snapshot_seconds.append(0.01)
        rows = records(generation)
        host.registry.extend(rows)
        return rows

    def retire() -> None:
        if host.block is None:
            return
        sampler = host.block.sampler
        snapshot = sampler.snapshot()
        assert snapshot["reserved_chunks"] == 0
        assert snapshot["delivered_chunks"] == snapshot["trained_chunks"]
        host.old_samplers.append((sampler, copy.deepcopy(snapshot)))
        host.retired.append(snapshot)
        host.block = None

    def acknowledge(
        batch: dict[str, Any],
        plan: list[tuple[int, int]],
        *,
        requested_ns: int,
        generation: int,
    ) -> None:
        assert batch["plan"] == plan and generation == host.generation
        host.block.sampler.mark_trained(plan)
        host.completed_updates += 1
        # A fixed logical event interval supplies a known decision input;
        # this is NOT measured/simulated optimizer throughput.
        host.clock += 1.0
        host.ready_update_seconds.append(1.0)
        host.plan_trace.append([list(pair) for pair in plan])

    host.install = install
    host.take = take
    host.retire = retire
    host.update = acknowledge
    host.prefetch = lambda: scope["prefetch"](host)
    host.flush_staging = lambda: None
    host.stage = lambda rows: setattr(
        host, "untrained_tail_sources", host.untrained_tail_sources + len(rows)
    )
    scope["overlap"](host)
    assert host.completed_updates == updates and host.flow.pending is None
    assert all(
        sampler.snapshot() == snapshot for sampler, snapshot in host.old_samplers
    ), "Retired source ledger was modified"
    usages = [row for ledger in host.retired for row in ledger["episodes"]]
    assert all(
        row["reserved"] == 0 and row["delivered"] == row["trained"] <= cap
        for row in usages
    )
    assert sum(row["trained"] for row in usages) == updates * 32
    return {
        "policy": policy,
        "completed_updates": host.completed_updates,
        "chunks": updates * 32,
        "requested_generations": host.flow.requests,
        "accepted_sources": len(host.registry),
        "trained_sources": sum(row["trained"] > 0 for row in usages),
        "untrained_tail_sources": host.untrained_tail_sources,
        "max_source_deliveries": max(row["delivered"] for row in usages),
        "ledgers": host.retired,
        "retired_ledgers_unchanged": True,
        "events": host.events,
        "plan_trace": host.plan_trace,
    }


def ledger_partial_case(scope: dict[str, Any]) -> dict[str, Any]:
    sampler = scope["BalancedAnchorSampler"](records(0), episode_budget=5)
    plan = sampler.reserve(32)
    sampler.mark_delivered(plan)
    sampler.mark_trained(plan)
    before = copy.deepcopy(sampler.snapshot())
    credits = sum(5 - v for v in sampler.delivered.values())
    assert credits == 8
    result = scope["_prefetch_decision"](
        remaining_updates=1,
        batch_size=32,
        remaining_credits=credits,
        handoff_seconds=100.0,
        update_seconds=1.0,
    )
    assert result["request"] and result["reason"] == "quota_required"
    assert sampler.snapshot() == before
    try:
        sampler.reserve(32)
    except StopIteration:
        pass
    else:
        raise AssertionError("Partial remaining capacity funded a complete batch")
    assert sampler.snapshot() == before
    return {
        "remaining_credits": credits,
        "decision": result,
        "ledger_unchanged_after_decision_and_rejected_batch": True,
    }


def recording_handoff_case(scope: dict[str, Any]) -> dict[str, Any]:
    sampler = scope["BalancedAnchorSampler"](records(0), episode_budget=128)
    before = copy.deepcopy(sampler.snapshot())
    events: list[dict[str, Any]] = []
    requests: list[int] = []
    host = SimpleNamespace(
        args=SimpleNamespace(
            updates=8, batch_size=32, episode_budget=128, prefetch_policy="budget"
        ),
        block=SimpleNamespace(sampler=sampler),
        completed_updates=0,
        generation=0,
        registry=records(0),
        staging=records(0),
        writer=SimpleNamespace(
            stats={
                "written_episodes": 0,
                "queue_capacity": 2,
                "sdk_write_encode_seconds": 0.0,
            }
        ),
        generation_seconds=[5.0],
        snapshot_seconds=[0.5],
        ready_update_seconds=[1.0] * 3,
        last_prefetch_decision=None,
        now=lambda: 1,
        metrics=SimpleNamespace(
            event=lambda kind, stamp, **kwargs: events.append(kwargs)
        ),
        flow=SimpleNamespace(request_refill=lambda: requests.append(1) or 1),
    )
    assert scope["prefetch"](host) is None
    assert events[-1]["handoff_seconds"] is None
    host.writer.stats.update(written_episodes=2, sdk_write_encode_seconds=4.0)
    assert scope["prefetch"](host) == 1
    assert events[-1]["handoff_seconds"] == 6.5
    assert requests == [1] and sampler.snapshot() == before
    return {
        "unknown_recording_is_conservative": True,
        "parallel_generation_and_recording_bound_seconds": 6.5,
        "snapshot_and_ledger_unchanged": True,
        "events": events,
    }


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--execute", action="store_true")
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    if not args.execute:
        print(
            json.dumps(
                {
                    "mode": "inspect_only",
                    "source": str(ROOT / "examples/ods/data_stream_demo/train.py"),
                    "scope": "Actual private decision/prefetch/overlap methods and actual sampler; no GPU or performance claims",
                },
                indent=2,
            )
        )
        return
    if args.output is None or args.output.exists():
        parser.error("--execute requires a fresh --output JSON")
    os.environ.update(
        CUDA_VISIBLE_DEVICES="",
        OMP_NUM_THREADS="1",
        MKL_NUM_THREADS="1",
        OPENBLAS_NUM_THREADS="1",
    )
    result: dict[str, Any] = {
        "passed": False,
        "scope": __doc__,
        "logical_event_times_are_not_performance_measurements": True,
    }
    try:
        scope, hashes = load()
        result["source_sha256"] = hashes
        result["decisions"] = decision_cases(scope)
        budget = caller_case(
            scope, policy="budget", updates=128, cap=128, supply_seconds=100.0
        )
        eager = caller_case(
            scope, policy="eager", updates=128, cap=128, supply_seconds=100.0
        )
        assert (
            budget["accepted_sources"] == 32
            and budget["trained_sources"] == 32
            and budget["untrained_tail_sources"] == 0
        )
        assert (
            eager["accepted_sources"] == 40
            and eager["trained_sources"] == 32
            and eager["untrained_tail_sources"] == 8
        )
        assert budget["plan_trace"] == eager["plan_trace"]
        fast = caller_case(
            scope, policy="budget", updates=8, cap=128, supply_seconds=0.1
        )
        assert fast["accepted_sources"] == fast["trained_sources"] == 40
        assert fast["max_source_deliveries"] == 16 < 128
        partial = caller_case(
            scope, policy="budget", updates=2, cap=5, supply_seconds=100.0
        )
        assert (
            partial["accepted_sources"] == partial["trained_sources"] == 16
            and partial["untrained_tail_sources"] == 0
        )
        result.update(
            slow_supply_budget=budget,
            slow_supply_eager=eager,
            fast_supply_budget=fast,
            partial_last_batch=partial,
            partial_ledger=ledger_partial_case(scope),
            recording_handoff=recording_handoff_case(scope),
            passed=True,
        )
    except Exception:
        result["error"] = traceback.format_exc()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    with args.output.open("x") as stream:
        json.dump(result, stream, indent=2, allow_nan=False)
        stream.write("\n")
    print(
        json.dumps(
            {
                "passed": result["passed"],
                "output": str(args.output),
                "error": result.get("error"),
            }
        ),
        flush=True,
    )
    raise SystemExit(0 if result["passed"] else 1)


if __name__ == "__main__":
    main()
