{
  "name": "embodichain-task-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/package-assets.mjs",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "format:check": "prettier --check src tests scripts *.ts *.json ../graph-ui/src ../graph-ui/package.json"
  },
  "dependencies": {
    "@embodichain/graph-ui": "file:../graph-ui",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@xyflow/react": "12.11.6",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.7",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
