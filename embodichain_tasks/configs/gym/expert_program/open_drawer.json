            "translation_axis": [0.0, 1.0, 0.0]
        }
    },
    "robot": {
        "class_type": "URRobot",
        "robot_type": "ur5",
        "uid": "UR5",
        "urdf_cfg": {
            "components": [
                {
                    "component_type": "hand",
                    "urdf_path": "DH_PGI_140_80/DH_PGI_140_80.urdf"
