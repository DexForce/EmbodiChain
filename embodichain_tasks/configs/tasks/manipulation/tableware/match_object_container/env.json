                    "rotation_range": [[0, 0, -0.52], [0, 0, 0.52]],
                    "relative_position": false
                }
            }
        },
        "observations": {
            "norm_robot_eef_joint": {
                "func": "normalize_robot_joint_data",
                "mode": "modify",
                "name": "robot/qpos",
                "params": {
                    "joint_ids": [6, 13]
                }
            },
            "block_cube_1_pose": {
                "func": "get_rigid_object_pose",
                "mode": "add",
                "name": "block_cube_1_pose",
                "params": {
                    "entity_cfg": {"uid": "block_cube_1"}
                }
            },
            "block_sphere_1_pose": {
                "func": "get_rigid_object_pose",
                "mode": "add",
                "name": "block_sphere_1_pose",
                "params": {
