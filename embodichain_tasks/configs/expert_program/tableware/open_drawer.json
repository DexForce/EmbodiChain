{
    "schema_version": 2,
    "program_id": "open_drawer",
    "integration": {
        "robot_profile": "cobot_magic_right_manipulator_v2",
        "scene_registry": "open_drawer_v2",
        "runtime_preset": "safe"
    },
    "targets": {},
    "program": {
        "kind": "segment",
        "name": "open_drawer",
        "steps": {
            "kind": "invoke",
            "call": {
                "kind": "registered",
                "call_id": "embodichain_tasks.open_drawer",
                "schema_version": 1,
                "arguments": {
                    "handle": "drawer_handle",
                    "direction": "pull",
                    "hand_interp_steps": 20,
                    "approach_distance": 0.10,
                    "translation_distance": 0.12
                },
                "resources": {
                    "primary": "right_manipulator"
                }
            }
        },
        "post": [
            {
                "kind": "wait_stable",
                "entity": "drawer",
                "preset": "articulation"
            }
        ],
        "validators": [
            {
                "kind": "articulation_joint_position",
                "articulation": "drawer",
                "joint": "slide_rails",
                "minimum_position": 0.09
            }
        ]
    }
}
